#!/bin/sh
set -e
if [ "$1" = remove ]; then
    # Queues using this package's backend cannot print without it.
    LC_ALL=C lpstat -h /run/cups/cups.sock -v 2>/dev/null |
        awk '$NF ~ /^fichero:/ { sub(/:$/, "", $3); print $3 }' |
        while read -r queue; do
            lpadmin -h /run/cups/cups.sock -x "$queue" || true
        done
fi
exit 0
