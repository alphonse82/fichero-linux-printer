# AiYin D11s/FICHERO (09c5:0200): give CUPS (group lp) and the seat user access,
# and create its CUPS queue when it is plugged in, like other USB printers.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09c5", ATTR{idProduct}=="0200", GROUP="lp", MODE="0660", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="09c5", ATTR{idProduct}=="0200", ATTR{serial}=="?*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="fichero-printer@$attr{serial}.service"
